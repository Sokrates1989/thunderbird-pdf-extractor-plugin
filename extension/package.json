    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/archiver": "8.0.0",
    "@types/node": "20.19.43",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "4.1.10"
  }
}
