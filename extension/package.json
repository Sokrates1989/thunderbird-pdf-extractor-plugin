{
  "name": "thunderbird-pdf-extractor-extension",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/build.mjs --clean",
    "lint": "eslint .",
